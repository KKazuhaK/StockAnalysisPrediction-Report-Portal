# Runtime image, built by the Release workflow. The binary is cross-compiled
# per platform in CI and downloaded as an artifact (COPY, no in-container build);
# buildx picks the right arch via TARGETARCH.
# wkhtmltopdf uses the official patched-Qt .deb (headless, no X) for self-contained PDF generation.
#
# FONTS. debian:bookworm-slim ships none, so every glyph an exported report can draw is one we put
# here on purpose. An uncovered codepoint does not error — wkhtmltopdf silently draws nothing — so
# the set is pinned deliberately and then verified by a gate at the bottom of this RUN.
#   Noto Sans CJK SC   the body face: full CJK range, OFL, pinned upstream tag + sha256. A single
#                      weight (~16 MB), not the fonts-noto-cjk package (~215 MB, every weight and
#                      script — overkill here; ADR 0020 and 0021 both cite that call).
#   Noto Emoji         MONOCHROME and outline-only. The colour build is 99% CBDT raster, which PDF
#                      has no concept of: it embeds and then renders as a blank page (measured,
#                      ink=0), so it would silently drop the very characters it claims to fix.
#   fonts-dejavu-core  named explicitly, not left to chance. It used to arrive only as an
#                      alternatives dependency of fontconfig-config, yet it is the sole provider of
#                      72 corpus codepoints (super/subscripts, several arrows and currency signs).
#                      Load-bearing coverage must not depend on how apt resolves an alternation.
# Together these cover every codepoint in scripts/font-coverage-corpus.txt except six rare currency
# signs, which the corpus marks advisory.
FROM debian:bookworm-slim
ARG TARGETARCH

ARG NOTO_CJK_SHA256=2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b
ARG NOTO_EMOJI_SHA256=de6c18832938afc99caf132b39d6a30a19bac7f2e812e28db2535b4608d27551
# -nv rather than -q on every fetch: -q suppresses the HTTP status too, so a 404 or a proxy error
# aborts the build with no output at all and nothing to diagnose from the log.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata fontconfig fonts-dejavu-core gosu wget \
 && mkdir -p /usr/share/fonts/opentype/noto /usr/share/fonts/truetype/noto \
 && wget -nvO /usr/share/fonts/opentype/noto/NotoSansCJKsc-Regular.otf \
      "https://raw.githubusercontent.com/notofonts/noto-cjk/Sans2.004/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf" \
 && echo "${NOTO_CJK_SHA256}  /usr/share/fonts/opentype/noto/NotoSansCJKsc-Regular.otf" | sha256sum -c - \
 && wget -nvO /usr/share/fonts/truetype/noto/NotoEmoji-Regular.ttf \
      "https://raw.githubusercontent.com/google/fonts/2d85e20401920891efb7cd6272d6339685df2820/ofl/notoemoji/NotoEmoji%5Bwght%5D.ttf" \
 && echo "${NOTO_EMOJI_SHA256}  /usr/share/fonts/truetype/noto/NotoEmoji-Regular.ttf" | sha256sum -c - \
 && wget -nvO /tmp/wkhtmltox.deb \
      "https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bookworm_${TARGETARCH}.deb" \
 && apt-get install -y --no-install-recommends /tmp/wkhtmltox.deb \
 && fc-cache -f \
 && rm -rf /tmp/wkhtmltox.deb /var/lib/apt/lists/*

# The gate is its own layer, after the fonts, so editing the corpus re-runs only the check rather
# than re-downloading ~35 MB of fonts and deb per arch. It stays in the image because a support
# question about a customer's PDF is answered by running it against that exact container.
COPY scripts/font-coverage-corpus.txt scripts/probe-font-coverage.sh \
     /usr/local/share/report-portal/
RUN chmod +x /usr/local/share/report-portal/probe-font-coverage.sh \
 && /usr/local/share/report-portal/probe-font-coverage.sh

ENV TZ=UTC RP_CONFIG=/app/config/config.yaml
WORKDIR /app
COPY bin/linux-${TARGETARCH}/report-portal /app/report-portal
COPY config.example.yaml /app/config.example.yaml
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /app/report-portal /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /app/config /app/data
EXPOSE 8790
# Start as root (the entrypoint fixes bind-mount ownership), then gosu drops to PUID/PGID (default 10001).
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

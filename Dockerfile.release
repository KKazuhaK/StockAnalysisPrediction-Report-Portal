# Runtime image, built by the Release workflow. The binary is cross-compiled
# per platform in CI and downloaded as an artifact (COPY, no in-container build);
# buildx picks the right arch via TARGETARCH.
# wkhtmltopdf uses the official patched-Qt .deb (headless, no X) for self-contained PDF generation.
#
# FONTS. debian:bookworm-slim ships none, so every glyph an exported report can draw is one we put
# here on purpose. An uncovered codepoint does not error — wkhtmltopdf silently draws nothing — so
# the set is pinned deliberately and then verified by the coverage gate a few lines below.
#   Noto Sans CJK SC   the body face: full CJK range, OFL, pinned upstream tag + sha256. A single
#                      weight (~16 MB), not the fonts-noto-cjk package (~215 MB, every weight and
#                      script — overkill here; ADR 0020 and 0021 both cite that call).
#   Noto Emoji         MONOCHROME and outline-only. The colour build is 99% CBDT raster, which PDF
#                      has no concept of: it embeds and then renders as a blank page (measured,
#                      ink=0), so it would silently drop the very characters it claims to fix.
#   fonts-dejavu-core  named explicitly, not left to chance. It used to arrive only as an
#                      alternatives dependency of fontconfig-config, yet it is the sole provider of
#                      72 corpus codepoints (super/subscripts, several arrows and currency signs).
#                      Load-bearing coverage must not depend on how apt resolves an alternation.
# Together these cover every codepoint in scripts/font-coverage-corpus.txt except six rare currency
# signs, which the corpus marks advisory.
ARG NOTO_CJK_SHA256=2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b
ARG NOTO_EMOJI_SHA256=de6c18832938afc99caf132b39d6a30a19bac7f2e812e28db2535b4608d27551

# Stage 1 — fetch the fonts and repair the CJK one's cmap.
#
# Noto Sans CJK SC addresses the same glyphs twice: as unified ideographs and as the radical blocks
# that look identical (月 U+6708 and ⽉ U+2F49 are one glyph). Qt writes the PDF's ToUnicode table by
# reverse-mapping glyph -> codepoint and takes the lowest, so every 月 in an exported report landed
# in the text layer as ⽉. The page looked right and the text under it was wrong: search found
# nothing, copy-paste produced characters nobody typed. Dropping the radical mappings leaves one way
# to address each glyph. See scripts/strip-radical-cmap.py for the measurements.
#
# This runs in a builder stage so python3-fonttools never reaches the runtime image, and pinned to
# BUILDPLATFORM because its output is a font file — identical whichever arch produced it. Left to
# TARGETPLATFORM the arm64 leg would run Python over a 16 MB font under QEMU for no gain.
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS fonts
ARG NOTO_CJK_SHA256
ARG NOTO_EMOJI_SHA256
COPY scripts/strip-radical-cmap.py /usr/local/bin/strip-radical-cmap.py
# -nv rather than -q on every fetch: -q suppresses the HTTP status too, so a 404 or a proxy error
# aborts the build with no output at all and nothing to diagnose from the log.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates python3 python3-fonttools wget \
 && mkdir -p /out/opentype/noto /out/truetype/noto \
 && wget -nv -O /tmp/NotoSansCJKsc-Regular.otf \
      "https://raw.githubusercontent.com/notofonts/noto-cjk/Sans2.004/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf" \
 && echo "${NOTO_CJK_SHA256}  /tmp/NotoSansCJKsc-Regular.otf" | sha256sum -c - \
 && python3 /usr/local/bin/strip-radical-cmap.py \
      /tmp/NotoSansCJKsc-Regular.otf /out/opentype/noto/NotoSansCJKsc-Regular.otf \
 && wget -nv -O /out/truetype/noto/NotoEmoji-Regular.ttf \
      "https://raw.githubusercontent.com/google/fonts/2d85e20401920891efb7cd6272d6339685df2820/ofl/notoemoji/NotoEmoji%5Bwght%5D.ttf" \
 && echo "${NOTO_EMOJI_SHA256}  /out/truetype/noto/NotoEmoji-Regular.ttf" | sha256sum -c -

# Stage 2 — the runtime, up to and including the font gate. CI builds this target on every push, so
# the font chain is exercised before a tag exists rather than for the first time during a release.
FROM debian:bookworm-slim AS runtime-base
ARG TARGETARCH
COPY --from=fonts /out/opentype/noto/ /usr/share/fonts/opentype/noto/
COPY --from=fonts /out/truetype/noto/ /usr/share/fonts/truetype/noto/
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata fontconfig fonts-dejavu-core gosu wget \
 && wget -nv -O /tmp/wkhtmltox.deb \
      "https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bookworm_${TARGETARCH}.deb" \
 && apt-get install -y --no-install-recommends /tmp/wkhtmltox.deb \
 && fc-cache -f \
 && rm -rf /tmp/wkhtmltox.deb /var/lib/apt/lists/*

# The gate is its own layer, after the fonts, so editing the corpus re-runs only the check rather
# than re-downloading ~35 MB of fonts and deb per arch. It stays in the image because a support
# question about a customer's PDF is answered by running it against that exact container.
COPY scripts/font-coverage-corpus.txt scripts/probe-font-coverage.sh \
     /usr/local/share/report-portal/
RUN chmod +x /usr/local/share/report-portal/probe-font-coverage.sh \
 && /usr/local/share/report-portal/probe-font-coverage.sh

FROM runtime-base
ARG TARGETARCH

ENV TZ=UTC RP_CONFIG=/app/config/config.yaml
WORKDIR /app
COPY bin/linux-${TARGETARCH}/report-portal /app/report-portal
COPY config.example.yaml /app/config.example.yaml
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /app/report-portal /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /app/config /app/data
EXPOSE 8790
# /healthz checks the database, not just the process — an orchestrator can already see a dead
# process; what it cannot see is the portal up with its database unreachable, serving an error on
# every page. The app caches the verdict, so probing costs at most one query every couple of
# seconds. start-period covers first-run schema creation on a cold database.
#
# This is a READINESS signal, not a liveness one: it goes red for a reason restarting the portal
# cannot fix. Plain Docker only reports it, which is what we want. If you run this under something
# that restarts unhealthy containers (Swarm, Kubernetes with this as a livenessProbe), point that at
# the process instead, or an unreachable database becomes a restart loop on top of an outage.
#
# wget's exit code is what carries the verdict: GNU wget exits 8 on a 5xx and 0 on 200, so the 503
# this endpoint returns when the database is unreachable marks the container unhealthy.
#
# The port follows RP_LISTEN rather than being hardcoded. Hardcoded, an operator who moves the
# listener gets a container that reports unhealthy for ever while serving perfectly — a trap that
# looks like the healthcheck working. ${RP_LISTEN##*:} takes the port off ":9000", "0.0.0.0:9000"
# or a bare port alike, and falls back to the default when the variable is unset.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD p="${RP_LISTEN##*:}"; wget -qO- "http://127.0.0.1:${p:-8790}/healthz" || exit 1
# Start as root (the entrypoint fixes bind-mount ownership), then gosu drops to PUID/PGID (default 10001).
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
